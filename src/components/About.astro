---
import { Github, Linkedin, ShieldCheck, FileText, ArrowUpRight, GraduationCap, Award, MapPin } from 'lucide-react';
---

<section id="about" class="py-20 bg-[#eef4f0]/60 dark:bg-[#0c1812]/50 border-y border-[#3b5446]/15 dark:border-[#52b788]/15 relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      {/* Profile Photo & Quick Badges */}
      <div class="lg:col-span-5 flex flex-col items-center lg:items-start text-center lg:text-left">
        <div class="relative mb-6">
          {/* Glowing Ambient Ring */}
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-tr from-[#1e382b] via-[#52b788] to-[#95d5b2] opacity-50 blur-md transition duration-500 group-hover:opacity-80" />
          
          <div class="relative h-60 w-60 sm:h-64 sm:w-64 rounded-3xl bg-[#09130e] border border-[#52b788]/30 p-2 shadow-2xl overflow-hidden group">
            <img
              src="/images/mainuddin-profile.jpg"
              alt="Mainuddin Talukdar — AI Engineer in Christchurch, NZ"
              class="h-full w-full object-cover object-top rounded-2xl group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {/* Subtle Overlay with Location */}
            <div class="absolute bottom-2 inset-x-2 rounded-b-2xl bg-gradient-to-t from-[#09130e] via-[#09130e]/80 to-transparent p-3 text-left">
              <div class="text-xs font-bold text-white tracking-tight">Mainuddin Talukdar</div>
              <div class="flex items-center gap-1 text-[10px] font-mono text-[#95d5b2]">
                <MapPin className="w-3 h-3 text-[#52b788]" />
                <span>Christchurch, New Zealand</span>
              </div>
            </div>
          </div>

          <span class="absolute -bottom-2 -right-2 flex h-9 w-9 items-center justify-center rounded-2xl bg-[#2d6a4f] text-white shadow-lg border border-[#52b788]/40" title="Verified Identity">
            <ShieldCheck className="w-5 h-5 text-[#95d5b2]" />
          </span>
        </div>

        {/* Social / External Links (No Plaintext Email/Phone) */}
        <div class="flex flex-wrap items-center gap-2.5 justify-center lg:justify-start">
          <a
            href="https://github.com/qmainuddin"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-full border border-[#3b5446]/25 dark:border-[#52b788]/30 bg-white/90 dark:bg-[#102018]/90 px-4 py-2 text-xs font-bold text-[#12221a] dark:text-[#f0f7f3] hover:bg-[#2d6a4f] hover:text-white dark:hover:bg-[#2d6a4f] transition shadow-sm"
          >
            <Github className="w-3.5 h-3.5" />
            <span>GitHub</span>
            <ArrowUpRight className="w-3 h-3 opacity-60" />
          </a>

          <a
            href="https://linkedin.com/in/mainuddintalukdar"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-full border border-[#3b5446]/25 dark:border-[#52b788]/30 bg-white/90 dark:bg-[#102018]/90 px-4 py-2 text-xs font-bold text-[#12221a] dark:text-[#f0f7f3] hover:bg-[#2d6a4f] hover:text-white dark:hover:bg-[#2d6a4f] transition shadow-sm"
          >
            <Linkedin className="w-3.5 h-3.5" />
            <span>LinkedIn</span>
            <ArrowUpRight className="w-3 h-3 opacity-60" />
          </a>
        </div>
      </div>

      {/* Narrative & Dynamic Gate Box */}
      <div class="lg:col-span-7 space-y-5">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#2d6a4f] dark:text-[#52b788]">
            About Me & Applied AI Focus
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#12221a] dark:text-white tracking-tight mt-1">
            Bridging Agentic AI Workflows & Production Full-Stack Systems.
          </h2>
        </div>

        <p class="text-base text-[#3b5446] dark:text-[#c3d9cc] leading-relaxed">
          I am a software engineer and <strong class="text-[#12221a] dark:text-white">Master of Artificial Intelligence student</strong> at the University of Canterbury (Christchurch, NZ) with <strong class="text-[#12221a] dark:text-white">nine years of experience</strong> designing, building, and shipping production systems — most of it in <strong class="text-[#12221a] dark:text-white">Java and Spring Boot</strong> — now focused on applied AI with <strong class="text-[#12221a] dark:text-white">Python</strong>.
        </p>

        <p class="text-base text-[#3b5446] dark:text-[#c3d9cc] leading-relaxed">
          The backend, object-oriented, and distributed-systems foundations I built across nine years in Java transfer directly to Python, which I use across AI projects, data pipelines, and microservices. I build LLM-powered agents end to end, using Claude and Claude Code, Cursor, and Codex well beyond chat — for agentic coding, tool use, and automated workflows — alongside full-stack delivery in <strong class="text-[#12221a] dark:text-white">TypeScript and Next.js</strong>.
        </p>

        {/* Academic & Achievement Grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div class="rounded-2xl border border-[#3b5446]/15 dark:border-[#52b788]/20 bg-white/70 dark:bg-[#102018]/70 p-3.5 flex items-start gap-2.5">
            <GraduationCap className="w-4 h-4 text-[#2d6a4f] dark:text-[#52b788] shrink-0 mt-0.5" />
            <div>
              <div class="text-xs font-bold text-[#12221a] dark:text-white">Master of Artificial Intelligence</div>
              <div class="text-[11px] text-[#60796d] dark:text-[#a3c4b2]">University of Canterbury &bull; Current (NZQA Level 9)</div>
            </div>
          </div>

          <a
            href="https://ieeexplore.ieee.org/document/11022382/"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-2xl border border-[#3b5446]/15 dark:border-[#52b788]/20 bg-white/70 dark:bg-[#102018]/70 p-3.5 flex items-start gap-2.5 hover:border-[#52b788]/50 transition group"
          >
            <Award className="w-4 h-4 text-[#2d6a4f] dark:text-[#52b788] shrink-0 mt-0.5" />
            <div class="flex-1">
              <div class="text-xs font-bold text-[#12221a] dark:text-white flex items-center justify-between">
                <span>IEEE Publication (ICCIT)</span>
                <ArrowUpRight className="w-3 h-3 text-[#2d6a4f] dark:text-[#52b788] opacity-70 group-hover:opacity-100 transition" />
              </div>
              <div class="text-[11px] text-[#60796d] dark:text-[#a3c4b2]">“A Stacked Meta-Model Framework for Diabetes Prediction”</div>
            </div>
          </a>

          <div class="rounded-2xl border border-[#3b5446]/15 dark:border-[#52b788]/20 bg-white/70 dark:bg-[#102018]/70 p-3.5 flex items-start gap-2.5">
            <GraduationCap className="w-4 h-4 text-[#2d6a4f] dark:text-[#52b788] shrink-0 mt-0.5" />
            <div>
              <div class="text-xs font-bold text-[#12221a] dark:text-white">MS in Computer Science</div>
              <div class="text-[11px] text-[#60796d] dark:text-[#a3c4b2]">Maharishi International University, USA (2025)</div>
            </div>
          </div>

          <div class="rounded-2xl border border-[#3b5446]/15 dark:border-[#52b788]/20 bg-white/70 dark:bg-[#102018]/70 p-3.5 flex items-start gap-2.5">
            <GraduationCap className="w-4 h-4 text-[#2d6a4f] dark:text-[#52b788] shrink-0 mt-0.5" />
            <div>
              <div class="text-xs font-bold text-[#12221a] dark:text-white">BS in Software Engineering</div>
              <div class="text-[11px] text-[#60796d] dark:text-[#a3c4b2]">University of Dhaka, Bangladesh (2016) &bull; DhakaThon Champion</div>
            </div>
          </div>
        </div>

        {/* Dynamic Resume Gate Callout */}
        <div class="rounded-3xl border border-[#52b788]/30 bg-gradient-to-r from-white/90 via-[#eaf2ec]/90 to-white/90 dark:from-[#0e1c15] dark:via-[#13261d] dark:to-[#0e1c15] p-5 sm:p-6 backdrop-blur-sm shadow-sm">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 text-sm font-bold text-[#12221a] dark:text-white">
                <FileText className="w-4 h-4 text-[#2d6a4f] dark:text-[#52b788]" />
                <span>Verified Career Credentials & Full CV</span>
              </div>
              <p class="text-xs text-[#60796d] dark:text-[#a3c4b2] mt-1 max-w-md">
                Direct phone and email contact details are gated behind an automated intent verification system to eliminate scrapers and spam.
              </p>
            </div>

            <button
              onclick="window.dispatchEvent(new CustomEvent('open-resume-modal'))"
              class="shrink-0 inline-flex items-center gap-2 rounded-full bg-[#1e382b] dark:bg-[#2d6a4f] hover:bg-[#284a39] dark:hover:bg-[#388261] px-5 py-3 text-xs font-bold text-white shadow-sm transition transform hover:scale-105 active:scale-95"
            >
              <span>Unlock Resume PDF</span>
              <ArrowUpRight className="w-4 h-4" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

