---
import {
  AlertTriangle,
  CheckCircle2,
  ArrowUpRight,
  Award,
  BookOpen,
  ExternalLink,
} from 'lucide-react';

const featuredProjects = [
  {
    id: 'tradiepulse',
    title: 'TradiePulse Conversational AI Agent',
    category: 'Conversational AI & Proximity Matching',
    status: 'Live on Subdomain / Beta',
    role: 'Creator & Full-Stack AI Engineer',
    architecture: 'Next.js Frontend + Python Agent Service (NLP Matching) + Supabase + Docker + Caddy',
    impact: 'Interprets customer household problems in plain language, matches nearest qualified tradesperson (plumber, electrician, mechanic), and connects both parties.',
    description:
      'A conversational AI agent that lets a customer describe a household problem in plain language, the way they would to a person. The agent interprets the request, then finds the nearest available and suitably qualified tradesperson — plumber, electrician or mechanic — and connects the two. Built with a Next.js front end, a Python agent service for language understanding and matching, and Supabase for tradie profiles, availability and jobs; containerised with Docker and served on Hostinger VPS behind Caddy.',
    techStack: ['Next.js', 'Python Agent', 'Supabase', 'PostgreSQL', 'Docker', 'Caddy', 'Tailwind CSS'],
    retrospective: {
      failure:
        'Directly passing unconstrained conversational text to tradespeople caused ambiguity in job scopes and dispatch errors.',
      adaptation:
        'Architected a structured entity extraction pipeline in the Python agent service that translates ambiguous natural language descriptions into standardized trade categories, urgency levels, and location parameters before database matching.',
    },
    liveLink: 'https://tradiepulse.mainuddintalukdar.cloud',
    modalApp: 'tradiepulse',
  },
  {
    id: 'mathquest',
    title: 'MathQuest Adaptive Learning App',
    category: 'Adaptive Learning & Python ML Service',
    status: 'Production / Live Demo',
    role: 'Lead Architect & Full-Stack Engineer',
    architecture: 'Next.js + Supabase + Vercel + Python Scoring Microservice',
    impact: 'Tracks fine-grained engagement (time per question, attempts, accuracy), scores student mastery, and dynamically suggests practice exercises.',
    description:
      'An interactive maths learning app for primary-school children, built on Next.js, Supabase and Vercel. Children work through puzzle-based lessons while the app tracks how they engage — time per question, attempts and accuracy — in Supabase, then scores each child and suggests what to practise next. The scoring and suggestions run as a separate Python microservice, proving the end-to-end workflow ahead of a fully trained model.',
    techStack: ['Next.js', 'Python Microservice', 'Supabase', 'Vercel', 'Tailwind CSS', 'Web Audio API'],
    retrospective: {
      failure:
        'Embedding scoring heuristics directly in frontend components created inconsistent evaluation metrics and blocked future ML model integration.',
      adaptation:
        'Decoupled telemetry collection from recommendation logic into a standalone Python microservice, allowing independent scoring algorithms and smooth migration path toward deep reinforcement learning models.',
    },
    liveLink: 'https://mathquest.mainuddintalukdar.cloud',
    modalApp: 'mathquest',
  },
  {
    id: 'agent-harness',
    title: 'Dockerized Microservices & CI/CD Pipeline',
    category: 'Infrastructure & Delivery Harness',
    status: 'Active Production Standard',
    role: 'Cloud Architect & Systems Engineer',
    architecture: 'Docker Multi-Stage + GitHub Actions CI/CD + Caddy Reverse Proxy + Supabase RLS',
    impact: 'Automated test execution, smoke checks, and zero-downtime subdomain deployments serving live apps on mainuddintalukdar.cloud.',
    description:
      'Each project runs as its own Dockerised service, ships through a strict GitHub CI/CD pipeline with automated tests and smoke checks, and is served on its own subdomain via Caddy — establishing an observable, repeatable path from commit to production.',
    techStack: ['GitHub Actions', 'Docker', 'Caddy Reverse Proxy', 'TypeScript', 'Vitest', 'Zod Gates'],
    retrospective: {
      failure:
        'Manual deployment and ad-hoc subdomain routing caused configuration drift and intermittent SSL renewal failures across multiple microservices.',
      adaptation:
        'Automated the deployment pipeline using GitHub Actions with SSH orchestration and Caddy automated ACME certificate management, guaranteeing deterministic releases.',
    },
    liveLink: 'https://mainuddintalukdar.cloud',
  },
];
---

<section id="projects" class="py-20 bg-[#eef4f0]/60 dark:bg-[#0c1812]/50 border-y border-[#3b5446]/15 dark:border-[#52b788]/15">
  <div class="mx-auto max-w-7xl px-4 sm:6 lg:px-8">
    {/* Section Header */}
    <div class="max-w-3xl mx-auto text-center mb-14">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#2d6a4f] dark:text-[#52b788]">
        Shipped Systems & Engineering Depth
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#12221a] dark:text-white tracking-tight mt-1">
        Featured Projects & Engineering Retrospectives
      </h2>
      <p class="text-sm text-[#3b5446] dark:text-[#a3c4b2] mt-2">
        Real production applications with live demos, transparent architecture notes, and lessons learned through engineering adaptations.
      </p>
    </div>

    {/* Featured Projects Grid */}
    <div class="space-y-10 mb-16">
      {featuredProjects.map((project) => (
        <article class="rounded-3xl border border-[#3b5446]/15 dark:border-[#52b788]/20 bg-white/90 dark:bg-[#0e1d16]/90 overflow-hidden shadow-sm hover:border-[#52b788]/40 transition">
          <div class="p-6 sm:p-9 space-y-5">
            {/* Top Bar */}
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/5 dark:border-white/5 pb-4">
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono uppercase tracking-wider font-bold text-[#2d6a4f] dark:text-[#95d5b2] bg-[#2d6a4f]/10 dark:bg-[#52b788]/15 px-3 py-1 rounded-full">
                  {project.category}
                </span>
                <span class="inline-flex items-center gap-1.5 text-xs text-[#2d6a4f] dark:text-[#52b788] font-mono font-medium">
                  <span class="h-2 w-2 rounded-full bg-[#52b788] animate-pulse" />
                  {project.status}
                </span>
              </div>

              {/* Action Buttons */}
              <div class="flex items-center gap-2">
                {project.modalApp && (
                  <button
                    onclick={`window.dispatchEvent(new CustomEvent('open-apps-modal', { detail: { app: '${project.modalApp}' } }))`}
                    class="rounded-full border border-[#3b5446]/20 dark:border-[#52b788]/30 bg-white dark:bg-[#12241b] hover:bg-[#e6eee8] dark:hover:bg-[#162a20] px-4 py-1.5 text-xs font-bold text-[#12221a] dark:text-white transition"
                  >
                    Quick Preview
                  </button>
                )}
                <a
                  href={project.liveLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full bg-[#1e382b] hover:bg-[#284a39] dark:bg-[#2d6a4f] dark:hover:bg-[#388261] px-4 py-1.5 text-xs font-bold text-white transition shadow-sm"
                >
                  <span>Live App</span>
                  <ArrowUpRight className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>

            {/* Title & Architecture Note */}
            <div>
              <h3 class="text-xl sm:text-2xl font-bold text-[#12221a] dark:text-white tracking-tight">
                {project.title}
              </h3>
              <p class="text-xs font-mono text-[#2d6a4f] dark:text-[#95d5b2] mt-1">
                <strong>Stack:</strong> {project.architecture}
              </p>
            </div>

            {/* Description */}
            <p class="text-sm text-[#3b5446] dark:text-[#c3d9cc] leading-relaxed">
              {project.description}
            </p>

            {/* Impact Metric Callout */}
            <div class="rounded-2xl border border-[#52b788]/30 bg-[#52b788]/10 p-4 text-xs sm:text-sm text-[#1e382b] dark:text-[#d8e8dc]">
              <strong>Measured Delivery:</strong> {project.impact}
            </div>

            {/* Retrospective Box (Failure vs Adaptation) */}
            <div class="rounded-2xl border border-black/5 dark:border-white/5 bg-[#f4f8f5]/80 dark:bg-[#12241b]/80 p-5 space-y-3">
              <div class="text-xs font-mono font-bold uppercase tracking-wider text-[#60796d] dark:text-[#8aa596]">
                Engineering Retrospective: Challenge & Solution
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex items-start gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 mt-0.5">
                    <AlertTriangle className="w-3 h-3" />
                  </span>
                  <div class="text-xs text-[#3b5446] dark:text-[#c3d9cc]">
                    <strong class="text-[#12221a] dark:text-white">The Engineering Challenge:</strong>
                    <p class="mt-0.5">{project.retrospective.failure}</p>
                  </div>
                </div>

                <div class="flex items-start gap-2.5">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#52b788]/15 text-[#2d6a4f] dark:text-[#95d5b2] mt-0.5">
                    <CheckCircle2 className="w-3 h-3" />
                  </span>
                  <div class="text-xs text-[#3b5446] dark:text-[#c3d9cc]">
                    <strong class="text-[#12221a] dark:text-white">The Architectural Adaptation:</strong>
                    <p class="mt-0.5">{project.retrospective.adaptation}</p>
                  </div>
                </div>
              </div>
            </div>

            {/* Tech Badges */}
            <div class="flex flex-wrap gap-2 pt-1">
              {project.techStack.map((tech) => (
                <span class="rounded-full border border-[#3b5446]/15 dark:border-[#52b788]/20 bg-[#f4f8f5] dark:bg-[#12241b] px-3 py-1 text-xs font-mono text-[#2d4d3c] dark:text-[#c3d9cc]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Real Academic Publication & Hackathon Achievement Showcase */}
    <div class="rounded-3xl border border-[#52b788]/30 bg-gradient-to-r from-white via-[#eef6f1] to-white dark:from-[#0e1c15] dark:via-[#13281e] dark:to-[#0e1c15] p-6 sm:p-9 shadow-lg">
      <div class="flex items-center gap-2.5 mb-6">
        <span class="flex h-9 w-9 items-center justify-center rounded-2xl bg-[#2d6a4f]/10 dark:bg-[#52b788]/15 text-[#2d6a4f] dark:text-[#95d5b2] border border-[#2d6a4f]/20">
          <BookOpen className="w-5 h-5" />
        </span>
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#2d6a4f] dark:text-[#52b788]">
            Academic Research & Achievements
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-[#12221a] dark:text-white tracking-tight">
            Peer-Reviewed Publication & National Hackathon
          </h3>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* IEEE Paper Card */}
        <div class="rounded-2xl border border-[#3b5446]/20 dark:border-[#52b788]/30 bg-white/90 dark:bg-[#09130e]/90 p-5 sm:p-6 space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-mono font-bold text-[#2d6a4f] dark:text-[#95d5b2] bg-[#2d6a4f]/10 dark:bg-[#52b788]/15 px-3 py-0.5 rounded-full">
                IEEE Publication &bull; ICCIT
              </span>
              <span class="text-xs text-[#60796d] dark:text-[#8aa596] font-mono">Peer-Reviewed</span>
            </div>
            <h4 class="text-base font-bold text-[#12221a] dark:text-white leading-snug">
              &ldquo;A Stacked Meta-Model Framework for Diabetes Prediction&rdquo;
            </h4>
            <p class="text-xs text-[#3b5446] dark:text-[#c3d9cc] leading-relaxed">
              Applied advanced feature engineering, ensemble stacking, and meta-learning algorithms to a real-world biomedical machine learning dataset to achieve superior predictive accuracy and generalization.
            </p>
          </div>

          <div class="pt-2">
            <a
              href="https://ieeexplore.ieee.org/document/11022382/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-[#1e382b] hover:bg-[#284a39] dark:bg-[#2d6a4f] dark:hover:bg-[#388261] px-4 py-2 text-xs font-bold text-white transition shadow-sm"
            >
              <span>View IEEE Xplore Paper</span>
              <ExternalLink className="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        {/* DhakaThon 2015 Champion Card */}
        <div class="rounded-2xl border border-[#3b5446]/20 dark:border-[#52b788]/30 bg-white/90 dark:bg-[#09130e]/90 p-5 sm:p-6 space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-mono font-bold text-[#2d6a4f] dark:text-[#95d5b2] bg-[#2d6a4f]/10 dark:bg-[#52b788]/15 px-3 py-0.5 rounded-full">
                Champion &bull; 1st Place
              </span>
              <span class="text-xs text-[#60796d] dark:text-[#8aa596] font-mono">100+ Teams</span>
            </div>
            <h4 class="text-base font-bold text-[#12221a] dark:text-white leading-snug flex items-center gap-2">
              <Award className="w-4 h-4 text-[#2d6a4f] dark:text-[#52b788]" />
              <span>DhakaThon 2015 National Hackathon</span>
            </h4>
            <p class="text-xs text-[#3b5446] dark:text-[#c3d9cc] leading-relaxed">
              Awarded 1st Place among 100+ competing engineering teams in a national two-day rapid application development hackathon, demonstrating rapid prototyping, architectural execution, and effective presentation under tight constraints.
            </p>
          </div>

          <div class="pt-2">
            <span class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[#2d6a4f] dark:text-[#95d5b2]">
              <CheckCircle2 className="w-3.5 h-3.5 text-[#52b788]" />
              <span>National Engineering Championship</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
