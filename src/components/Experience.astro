---
import { Briefcase, TrendingUp } from 'lucide-react';

const experiences = [
  {
    role: 'Software Development Engineer II',
    company: 'Aperia Solutions (Client: Fiserv)',
    period: 'Aug 2024 – Feb 2026',
    location: 'New Jersey, USA',
    impactHighlight: 'Improved peak-load API response times by ~40% and cut read latency by >80% with Redis caching for millions of daily users.',
    achievements: [
      'Provided technical leadership on assigned features, owning requirements analysis, design, build, test, deployment, and documentation across payment and reporting services.',
      'Built and optimised RESTful APIs and enterprise integrations, improving response time by ~40% under peak load, and integrated Redis caching to cut average read latency by over 80% for real-time updates serving millions of daily users.',
      'Automated build, test, and deployment through CI/CD pipelines with Git workflows, Jira tracking, and monitoring, communicating technical trade-offs clearly to internal and client stakeholders.',
    ],
  },
  {
    role: 'Software Developer → Senior Software Developer',
    company: 'Vantage Labs',
    period: 'Jun 2019 – Aug 2023',
    location: 'Pennsylvania, USA (Remote)',
    impactHighlight: 'Shipped 2 React Native apps to Apple App Store & Google Play; led Python data pipelines lifting athlete revenue ~9.7% annually.',
    achievements: [
      'Built full-stack products end to end in TypeScript, React, and Node.js — including two React Native apps shipped to the Apple App Store and Google Play — with REST APIs, Firebase authentication, and real-time data.',
      'Led data-analysis pipelines in Python with Hadoop and Spark to process large-scale performance data, driving athlete recommendations that lifted revenue ~9.7% annually.',
      'Wrote unit and integration tests, resolved UI performance issues, deployed to AWS (Lambda, S3, NoSQL) with monitoring, and was promoted to Senior for sustained impact.',
    ],
  },
  {
    role: 'Software Developer',
    company: 'TigerIT Bangladesh Ltd',
    period: 'Jun 2016 – Jun 2019',
    location: 'Dhaka, Bangladesh',
    impactHighlight: 'Delivered national-scale government identity systems serving 100M+ citizens, cutting licence processing time by ~30%.',
    achievements: [
      'Delivered national-scale government systems serving over 100 million people, built on Spring Boot, Oracle, and WebLogic, cutting licence processing time by ~30%.',
      'Built automated test suites and reporting pipelines with SparkSQL and Kafka to improve reliability and deliver real-time operational insight over 35 TB of data.',
    ],
  },
];
---

<section id="experience" class="py-20 relative">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-14">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#2d6a4f] dark:text-[#52b788]">
        Career Trajectory & Track Record
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#12221a] dark:text-white tracking-tight mt-1">
        Experience & Quantifiable Impact
      </h2>
      <p class="text-sm text-[#3b5446] dark:text-[#a3c4b2] mt-2">
        Nine years of engineering leadership, production cloud systems, and measurable performance optimizations across enterprise platforms.
      </p>
    </div>

    {/* Timeline Container */}
    <div class="max-w-4xl mx-auto space-y-8 relative before:absolute before:inset-0 before:left-5 sm:before:left-1/2 before:w-0.5 before:bg-[#3b5446]/20 dark:before:bg-[#52b788]/20 before:-translate-x-1/2">
      {experiences.map((exp, index) => (
        <div class="relative flex flex-col sm:flex-row items-start group">
          {/* Central Bullet */}
          <div class="absolute left-5 sm:left-1/2 -translate-x-1/2 mt-1.5 flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#2d6a4f] dark:border-[#52b788] bg-white dark:bg-[#0e1d16] text-[#2d6a4f] dark:text-[#52b788] shadow-sm z-10">
            <Briefcase className="w-4 h-4" />
          </div>

          {/* Content Card */}
          <div class={`ml-12 sm:ml-0 w-full sm:w-[calc(50%-2.5rem)] ${index % 2 === 0 ? 'sm:mr-auto sm:pr-4 text-left' : 'sm:ml-auto sm:pl-4 text-left'}`}>
            <div class="rounded-3xl border border-[#3b5446]/15 dark:border-[#52b788]/20 bg-white/90 dark:bg-[#0e1d16]/90 p-6 shadow-sm hover:border-[#52b788]/40 transition">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <span class="text-xs font-mono font-bold text-[#2d6a4f] dark:text-[#52b788] bg-[#2d6a4f]/10 dark:bg-[#52b788]/15 px-3 py-0.5 rounded-full">
                  {exp.period}
                </span>
                <span class="text-[11px] font-mono text-[#60796d] dark:text-[#8aa596]">
                  {exp.location}
                </span>
              </div>

              <h3 class="text-base font-bold text-[#12221a] dark:text-white">
                {exp.role}
              </h3>
              <p class="text-xs font-semibold text-[#60796d] dark:text-[#a3c4b2] mb-3">
                {exp.company}
              </p>

              {/* Metric Callout */}
              <div class="rounded-2xl border border-[#52b788]/30 bg-[#52b788]/10 p-3 mb-4 flex items-start gap-2 text-xs text-[#1e382b] dark:text-[#d8e8dc] font-medium">
                <TrendingUp className="w-4 h-4 shrink-0 text-[#2d6a4f] dark:text-[#52b788] mt-0.5" />
                <span><strong>Impact:</strong> {exp.impactHighlight}</span>
              </div>

              {/* Bullet Points */}
              <ul class="space-y-2 text-xs text-[#3b5446] dark:text-[#c3d9cc]">
                {exp.achievements.map((ach) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#2d6a4f] dark:text-[#52b788] font-bold mt-0.5">&bull;</span>
                    <span>{ach}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

