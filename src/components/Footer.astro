---
import { Github, Linkedin, ArrowUp } from 'lucide-react';
---

<footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-[#07090e] transition-colors py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-200 dark:border-slate-800/80">
      {/* Brand */}
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <div class="flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-600 text-white font-mono font-bold text-xs">
            MT
          </span>
          <span class="font-bold text-slate-900 dark:text-white tracking-tight">Mainuddin Talukdar</span>
        </div>
        <p class="text-xs text-slate-500 mt-1 max-w-md">
          Senior Full-Stack Architect & AI Systems Specialist &bull; Building deterministic agentic systems.
        </p>
      </div>

      {/* Status Badge & Socials */}
      <div class="flex flex-wrap items-center gap-4">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-mono text-emerald-600 dark:text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse" />
          <span>System Status: 100% Nominal</span>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="https://github.com/mainuddin"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Profile"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-indigo-400 hover:border-indigo-500 transition"
          >
            <Github className="w-4 h-4" />
          </a>
          <a
            href="https://linkedin.com/in/mainuddintalukdar"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn Profile"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-indigo-400 hover:border-indigo-500 transition"
          >
            <Linkedin className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 text-xs text-slate-500 dark:text-slate-500">
      <p>
        &copy; {new Date().getFullYear()} Mainuddin Talukdar. All rights reserved. Deployed on Hostinger VPS (`stack` network).
      </p>

      <a
        href="#hero"
        class="inline-flex items-center gap-1.5 text-xs text-indigo-500 hover:text-indigo-400 font-medium transition"
      >
        <span>Back to Top</span>
        <ArrowUp className="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</footer>
