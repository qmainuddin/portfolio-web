# ==============================================================================
# Portfolio & Lead Capture Platform - Environment Variables Template
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=development
PORT=4321
HOST=0.0.0.0
PUBLIC_SITE_URL=http://localhost:4321

# Supabase (PostgreSQL Database & Storage)
# Required for storing resume requests and retrieving the resume PDF asset
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_RESUME_FILE_PATH=mainuddin-talukdar-resume.pdf

# Email Delivery (Resend API)
# Required for dispatching branded transactional emails with the resume
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
RESEND_FROM_EMAIL="Mainuddin Talukdar <career@mainuddintalukdar.cloud>"
RESEND_NOTIFY_EMAIL=notifications@mainuddintalukdar.cloud

# AI Intent Analysis (Gemini / OpenAI API)
# Used to classify form submissions into Recruiter, Client, Engineering Peer, or Spam
GEMINI_API_KEY=AIzaSy...
# Or alternative LLM provider:
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
